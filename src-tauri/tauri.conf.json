{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notchpad",
  "version": "1.4.0",
  "identifier": "com.notchpad.desktop",
  "build": {
    "beforeDevCommand": "pnpm renderer:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm renderer:build",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "width": 523,
        "height": 364,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: notchpad: http://notchpad.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
