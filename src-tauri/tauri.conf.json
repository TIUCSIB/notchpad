{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notchpad",
  "version": "1.5.4",
  "identifier": "com.notchpad.desktop",
  "build": {
    "beforeDevCommand": "pnpm renderer:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm renderer:build",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "width": 523,
        "height": 364,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: notchpad: http://notchpad.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://v1.hitokoto.cn https://geoapi.qweather.com https://devapi.qweather.com https://*.qweatherapi.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGNzY3NjREQTQzMDNGNzMKUldSelB6Q2tUWFoyZjZCTnpHZ2ZGMlRvRnFEK3JlVk83dGdEVy9BTldrc3J3WUFsVG1zZnB2WDAK",
      "endpoints": [
        "https://github.com/TIUCSIB/notchpad/releases/latest/download/latest.json"
      ]
    }
  }
}
